# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# MariaDB
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=neoauth
MYSQL_USER=neoauth
MYSQL_PASSWORD=

# JWT signing key for the API (openssl rand -hex 32)
JWT_SECRET_KEY=

# Allowed browser origins for the API. Behind the bundled nginx proxy the app
# is same-origin, so this only matters for local dev or extra origins.
CORS_ORIGINS=http://localhost:8080

# Local port the web frontend is published on (localhost only)
WEB_PORT=8080

# Cloudflare Tunnel token (Cloudflare Zero Trust dashboard -> Tunnels).
# Only needed when running with: docker compose --profile tunnel up -d
TUNNEL_TOKEN=
